# Copie para backend/.env (ignorado pelo git) e preencha. Nunca versione valores reais.

NODE_ENV=development
PORT=3000

# Projeto Supabase de DESENVOLVIMENTO
SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Conexão pelo pooler (usada pela API em execução)
DATABASE_URL=
# Conexão direta (usada pelo Prisma nas migrations)
DIRECT_URL=

# Projeto Supabase de TESTE (testes de integração, concorrência e RLS; migrate reset permitido só aqui)
TEST_SUPABASE_URL=https://SEU-PROJETO-TESTE.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_DATABASE_URL=
TEST_DIRECT_URL=
# Banco-sombra do Prisma (pode ser o próprio projeto de teste)
SHADOW_DATABASE_URL=

# Seed do gerente inicial (dados fictícios em desenvolvimento)
SEED_GERENTE_EMAIL=
SEED_GERENTE_SENHA=

# Origens permitidas pelo CORS (web)
CORS_ORIGINS=http://localhost:3000
