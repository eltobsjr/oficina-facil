{
  "openapi": "3.1.0",
  "info": {
    "title": "OficinaFácil API",
    "version": "0.1.0",
    "description": "API do OficinaFácil. Toda regra de negócio vive aqui; o app só exibe. Valores sempre em centavos inteiros."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "tags": [
    {
      "name": "usuarios"
    },
    {
      "name": "clientes"
    },
    {
      "name": "veiculos"
    },
    {
      "name": "servicos"
    },
    {
      "name": "pecas"
    },
    {
      "name": "ordens"
    },
    {
      "name": "faturamento"
    },
    {
      "name": "avisos"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "access_token emitido pelo Supabase Auth"
      }
    },
    "schemas": {
      "UsuarioAtual": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil"
        ]
      },
      "Perfil": {
        "type": "string",
        "enum": [
          "ATENDENTE",
          "MECANICO",
          "ALMOXARIFE",
          "GERENTE"
        ]
      },
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "object",
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensagem": {
                "type": "string"
              },
              "detalhes": {}
            },
            "required": [
              "codigo",
              "mensagem"
            ]
          }
        },
        "required": [
          "erro"
        ]
      },
      "ListaUsuarios": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Usuario"
            }
          },
          "total": {
            "type": "integer"
          },
          "pagina": {
            "type": "integer"
          },
          "limite": {
            "type": "integer"
          }
        },
        "required": [
          "itens",
          "total",
          "pagina",
          "limite"
        ]
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          },
          "ativo": {
            "type": "boolean"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "perfil",
          "ativo",
          "criadoEm"
        ]
      },
      "CriarUsuario": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "Senha inicial; nunca é devolvida nem logada"
          }
        },
        "required": [
          "nome",
          "email",
          "perfil",
          "senha"
        ]
      },
      "AlterarUsuario": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          }
        }
      },
      "RedefinirSenha": {
        "type": "object",
        "properties": {
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "senha"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Usuário autenticado",
        "description": "Nome, e-mail e perfil do usuário dono do token. O app usa para montar o menu do perfil.",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAtual"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Usuário sem perfil ou inativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    },
    "/usuarios": {
      "get": {
        "summary": "Lista usuários",
        "description": "Busca por nome ou e-mail, filtros de perfil e situação, paginada. Só o gerente.",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            },
            "required": false,
            "name": "pagina",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20
            },
            "required": false,
            "name": "limite",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Busca por nome ou e-mail"
            },
            "required": false,
            "description": "Busca por nome ou e-mail",
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/Perfil"
            },
            "required": false,
            "name": "perfil",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "ativo",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuários",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaUsuarios"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      },
      "post": {
        "summary": "Cria usuário",
        "description": "Cria a conta no Supabase Auth e o perfil. Se o perfil falhar, a conta é removida.",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    },
    "/usuarios/{id}": {
      "get": {
        "summary": "Detalha usuário",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      },
      "patch": {
        "summary": "Altera nome e perfil",
        "description": "A troca de perfil vale a partir do próximo login. Não permite remover o último gerente.",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarUsuario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário alterado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Último gerente ativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    },
    "/usuarios/{id}/redefinir-senha": {
      "post": {
        "summary": "Redefine a senha",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedefinirSenha"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Senha redefinida"
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    },
    "/usuarios/{id}/inativar": {
      "post": {
        "summary": "Inativa o usuário",
        "description": "Marca como inativo e bane a conta no Auth. Nunca o último gerente ativo.",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário inativado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Último gerente ativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    },
    "/usuarios/{id}/ativar": {
      "post": {
        "summary": "Reativa o usuário",
        "tags": [
          "usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "2f1a7d9e-0c4b-4f2a-9e3d-6b8c1a5d7e90"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário reativado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Sem token ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão (só o gerente gere usuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido"
          }
        }
      }
    }
  },
  "webhooks": {}
}
